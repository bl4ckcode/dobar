    "version": "0.2.0",
    "configurations": [
        {
            "name": "barz",
            "request": "launch",
            "type": "dart",
            "deviceId": "web-server",
            "args": [
                "--web-port=8888"
            ]
        },
        {
            "name": "barz (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "deviceId": "web-server",
            "args": [
                "--web-port=8888"
            ]
        },
        {
            "name": "barz (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "deviceId": "web-server",
            "args": [
                "--web-port=8888"
            ]
        }
    ]
}