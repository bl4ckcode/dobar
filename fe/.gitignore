# Ignore lock file for pub dependencies (for applications; commit for packages)
pubspec.lock

# Android native build artifacts (CMake/NDK outputs)
android/app/.cxx/
android/app/CMakeCache.txt
android/app/**/CMakeFiles/

# Additional native build and cache directories
android/daemon/
android/native/

# iOS CocoaPods and build artifacts
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/App.framework
ios/Runner.xcodeproj/project.xcworkspace/
ios/Runner.xcodeproj/xcuserdata/

# Other desktop platform build artifacts
macos/
windows/ephemeral/
windows/build/
linux/ephemeral/
linux/build/

# Web build artifacts
web/.dart_tool/
web/build/

# Environment and generated configuration files
android/app/google-services.json
firebase.json

